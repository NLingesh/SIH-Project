# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://darktrace:darktrace@localhost:5432/darktrace
DATABASE_URL_SYNC=postgresql://darktrace:darktrace@localhost:5432/darktrace

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=darktrace123

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# File Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800

# Demo
DEMO_MODE=true
SEED_DEMO_DATA=true

# Authorized onion collection (leave allowlist empty until approved sources are configured)
TOR_SOCKS_PROXY=socks5://127.0.0.1:9050
ONION_ALLOWLIST=approved-source.onion
ONION_REQUEST_TIMEOUT_SECONDS=20
ONION_MAX_PAGES=10
ONION_MAX_RESPONSE_BYTES=2000000
